# Paramètres de départ ArduPilot Plane 4.7 (version stable, vérifiés dans le simulateur 4.7.1) pour le quadplane Huard DFR (6S)
# Contrôleur : TBS Lucid H7 Wing (firmware ArduPlane, cible TBS_LUCID_H7_WING).
# Charger dans Mission Planner :
#   Config > Full Parameter List > Load from file, puis Write Params et redémarrer.
# Les noms de paramètres changent parfois d'une version à l'autre : si Mission
# Planner signale un paramètre inconnu, chercher son nouveau nom dans la doc.
# Ces valeurs servent à démarrer ; l'accordage (QAUTOTUNE, AUTOTUNE) reste à faire.

# --- Quadplane ---------------------------------------------------------------
Q_ENABLE,1
# (redémarrer après Q_ENABLE pour voir les autres paramètres Q_)
Q_FRAME_CLASS,1
Q_FRAME_TYPE,1
Q_M_PWM_TYPE,6
Q_M_SPIN_ARM,0.08
Q_M_SPIN_MIN,0.12
Q_M_THST_HOVER,0.62
Q_M_BAT_VOLT_MAX,25.2
Q_M_BAT_VOLT_MIN,17.4
# inclinaison max en VTOL, en degrés (avant la 4.7 : Q_ANGLE_MAX,3000)
Q_A_ANGLE_MAX,30
Q_ASSIST_SPEED,14
# filet de sécurité (vols simulés dans le vent fort) : sous 20 m en vol d'avion, les moteurs
# VTOL aident automatiquement, par exemple si une rafale fait décrocher l'avion
Q_ASSIST_ALT,20
Q_TRANSITION_MS,5000
Q_TRANS_DECEL,2
Q_RTL_MODE,1
Q_LAND_FINAL_ALT,6
Q_GUIDED_MODE,1

# --- Sorties -----------------------------------------------------------------
# Groupes de timers du Lucid H7 Wing : 1-2 | 3-4 | 5-6 | 7-10 | 11-12
# S1 à S4 = moteurs VTOL en DShot (Tekko32 F4 45A)
# Ordre ArduPilot Quad X : 1 avant droit (CCW), 2 arrière gauche (CCW),
#                          3 avant gauche (CW),  4 arrière droit (CW)
SERVO1_FUNCTION,33
SERVO2_FUNCTION,34
SERVO3_FUNCTION,35
SERVO4_FUNCTION,36
# S5 = moteur propulsif
SERVO5_FUNCTION,70
SERVO6_FUNCTION,0
# S7/S8 = ailerons gauche/droit, S9 = profondeur
SERVO7_FUNCTION,4
SERVO8_FUNCTION,4
SERVO9_FUNCTION,19

# --- Vitesse air (Matek ASPD-4525 en I2C) -----------------------------------
ARSPD_TYPE,1
ARSPD_USE,1
AIRSPEED_MIN,16
# 22 m/s (79 km/h) : avec l'hélice 10x7, le propulseur ne pousse presque plus vers 90 km/h
# (vols simulés : plein gaz sans tenir 25 m/s ni l'altitude)
AIRSPEED_CRUISE,22
AIRSPEED_MAX,30
TRIM_THROTTLE,50

# --- Batterie GAONENG 6S3P Li-ion (capteur intégré au Lucid H7 Wing) ---------
# Vérifier la tension affichée au multimètre : TBS indique BATT_VOLT_MULT 21,
# la doc ArduPilot 11. Garder celui qui donne la bonne tension.
BATT_MONITOR,4
BATT_AMP_PERVLT,40
BATT_CAPACITY,13500
# seuils sur la tension « au repos » estimée, pas sur la tension qui chute sous la
# charge des moteurs VTOL (sinon fausse alarme au décollage : vu en simulation)
BATT_FS_VOLTSRC,1
BATT_LOW_VOLT,20.4
BATT_CRT_VOLT,19.8
# réserve de 30 % : en fin de pack Li-ion la tension chute et les moteurs VTOL perdent de la
# poussée ; au-delà, l'atterrissage vertical se fait moteurs presque à fond (vu en simulation)
BATT_LOW_MAH,4000
BATT_CRT_MAH,2500
# faible -> retour au point de départ ; critique -> atterrissage vertical sur place
BATT_FS_LOW_ACT,1
BATT_FS_CRT_ACT,4

# --- Sécurité radio -----------------------------------------------------------
THR_FAILSAFE,1
FS_SHORT_ACTN,0
FS_LONG_ACTN,1
FS_LONG_TIMEOUT,5
RTL_ALTITUDE,60

# --- Vol en cercle au-dessus des lieux ----------------------------------------
# rayon du cercle (m) ; en mission AUTO, utiliser LOITER_UNLIM sur le point de l'accident
ROLL_LIMIT_DEG,45
WP_LOITER_RAD,120

# --- Ports série du Lucid H7 Wing ---------------------------------------------
# SERIAL2 (UART2) = GPS Holybro Micro M10 (réglage par défaut)
# SERIAL6 (UART6) = récepteur ExpressLRS RP3 V2 (CRSF, câbler TX6 et RX6)
SERIAL6_PROTOCOL,23
# SERIAL4 (UART4) = nacelle SIYI (A8 mini ou ZT6)
SERIAL4_PROTOCOL,8
SERIAL4_BAUD,115
MNT1_TYPE,8
# SERIAL7 (UART7, avec contrôle de flux) = Raspberry Pi, MAVLink vers la 4G
SERIAL7_PROTOCOL,2
SERIAL7_BAUD,921

# --- Divers ------------------------------------------------------------------
# tous les contrôles avant armement (ArduPlane 4.7 ; avant la 4.7 : ARMING_CHECK,1)
ARMING_SKIPCHK,0
LOG_DISARMED,0

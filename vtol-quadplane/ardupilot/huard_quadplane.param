# Paramètres de départ ArduPilot Plane (4.5 / 4.6) pour le quadplane Huard
# Contrôleur : Matek H743-WING V3. Charger dans Mission Planner :
#   Config > Full Parameter List > Load from file, puis Write Params et redémarrer.
# Les noms de paramètres changent parfois d'une version à l'autre : si Mission
# Planner signale un paramètre inconnu, chercher son nouveau nom dans la doc.
# Ces valeurs servent à démarrer ; l'accordage (QAUTOTUNE, AUTOTUNE) reste à faire.

# --- Quadplane ---------------------------------------------------------------
Q_ENABLE,1
# (redémarrer après Q_ENABLE pour voir les autres paramètres Q_)
Q_FRAME_CLASS,1
Q_FRAME_TYPE,1
Q_M_PWM_TYPE,6
Q_M_SPIN_ARM,0.08
Q_M_SPIN_MIN,0.12
Q_M_THST_HOVER,0.40
Q_M_BAT_VOLT_MAX,16.8
Q_M_BAT_VOLT_MIN,11.6
Q_ANGLE_MAX,3000
Q_ASSIST_SPEED,12
Q_TRANSITION_MS,5000
Q_TRANS_DECEL,2
Q_RTL_MODE,1
Q_LAND_FINAL_ALT,6
Q_GUIDED_MODE,1

# --- Sorties (S1 à S4 = moteurs VTOL en DShot, même groupe de timers) --------
# Ordre ArduPilot Quad X : 1 avant droit (CCW), 2 arrière gauche (CCW),
#                          3 avant gauche (CW),  4 arrière droit (CW)
SERVO1_FUNCTION,33
SERVO2_FUNCTION,34
SERVO3_FUNCTION,35
SERVO4_FUNCTION,36
# S5 = moteur propulsif
SERVO5_FUNCTION,70
SERVO6_FUNCTION,0
# S7/S8 = ailerons gauche/droit, S9 = profondeur
SERVO7_FUNCTION,4
SERVO8_FUNCTION,4
SERVO9_FUNCTION,19

# --- Vitesse air (Matek ASPD-4525 en I2C) -----------------------------------
ARSPD_TYPE,1
ARSPD_USE,1
AIRSPEED_MIN,13
AIRSPEED_CRUISE,15
AIRSPEED_MAX,24
TRIM_THROTTLE,40

# --- Batterie 4S2P Li-ion (capteur intégré au H743-WING) ---------------------
BATT_MONITOR,4
BATT_CAPACITY,9000
BATT_LOW_VOLT,12.6
BATT_CRT_VOLT,12.0
BATT_LOW_MAH,2000
BATT_CRT_MAH,900
# faible -> retour au point de départ ; critique -> atterrissage vertical sur place
BATT_FS_LOW_ACT,1
BATT_FS_CRT_ACT,4

# --- Sécurité radio -----------------------------------------------------------
THR_FAILSAFE,1
FS_SHORT_ACTN,0
FS_LONG_ACTN,1
FS_LONG_TIMEOUT,5
RTL_ALTITUDE,60

# --- Divers ------------------------------------------------------------------
ARMING_CHECK,1
LOG_DISARMED,0

@@ -19,6 +19,7 @@
 #include "SIM_QuadPlane.h"
 
 #include <stdio.h>
+#include <stdlib.h>
 
 using namespace SITL;
 
@@ -107,6 +108,12 @@ QuadPlane::QuadPlane(const char *frame_str) :
     mass = frame->get_mass() * 1.5;
     frame->set_mass(mass);
 
+    // poussée max du moteur propulsif (N) : variable d'environnement SIM_POUSSEE_MAX_N
+    const char *poussee = getenv("SIM_POUSSEE_MAX_N");
+    if (poussee != nullptr) {
+        thrust_scale = strtof(poussee, nullptr);
+    }
+
     lock_step_scheduled = true;
 }
 
@@ -138,17 +145,22 @@ void QuadPlane::update(const struct sitl_input &input)
     // estimate voltage and current
     frame->current_and_voltage(battery_voltage, battery_current);
 
-    battery.set_current(battery_current);
-
     float throttle;
     if (reverse_thrust) {
         throttle = filtered_servo_angle(input, 2);
     } else {
         throttle = filtered_servo_range(input, 2);
     }
-    // assume 20A at full fwd throttle
     throttle = fabsf(throttle);
-    battery_current += 20 * throttle;
+    // courant du moteur propulsif, prélevé sur la batterie : SIM_COURANT_POUSSEUR_A à plein gaz
+    // (sinon 20 A, linéaire comme à l'origine)
+    static const char *courant_max = getenv("SIM_COURANT_POUSSEUR_A");
+    if (courant_max != nullptr) {
+        battery_current += strtof(courant_max, nullptr) * powf(throttle, 1.5f);
+    } else {
+        battery_current += 20 * throttle;
+    }
+    battery.set_current(battery_current);
     
     rot_accel += quad_rot_accel;
     accel_body += quad_accel_body;

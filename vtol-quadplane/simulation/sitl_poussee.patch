diff --git a/libraries/SITL/SIM_Plane.cpp b/libraries/SITL/SIM_Plane.cpp
index 6a0322c..7bcddaa 100644
--- a/libraries/SITL/SIM_Plane.cpp
+++ b/libraries/SITL/SIM_Plane.cpp
@@ -20,6 +20,7 @@
 #include "SIM_Plane.h"
 
 #include <stdio.h>
+#include <stdlib.h>
 #include <AP_Filesystem/AP_Filesystem_config.h>
 #include <AP_Filesystem/AP_Filesystem.h>
 
@@ -501,6 +502,13 @@ void Plane::calculate_forces(const struct sitl_input &input, Vector3f &rot_accel
     // scale thrust to newtons
     thrust *= thrust_scale;
 
+    // hélice réelle : la poussée baisse avec la vitesse et s'annule à la vitesse de pas
+    // (variable d'environnement SIM_VITESSE_PAS, en m/s)
+    static const char *vitesse_pas = getenv("SIM_VITESSE_PAS");
+    if (vitesse_pas != nullptr && thrust > 0) {
+        thrust *= constrain_float(1.0f - airspeed / strtof(vitesse_pas, nullptr), 0, 1);
+    }
+
     accel_body = Vector3f(thrust, 0, 0) + force;
     accel_body /= mass;
 
diff --git a/libraries/SITL/SIM_QuadPlane.cpp b/libraries/SITL/SIM_QuadPlane.cpp
index 924e1af..39fb1e0 100644
--- a/libraries/SITL/SIM_QuadPlane.cpp
